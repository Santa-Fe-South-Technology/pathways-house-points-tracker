# Netlify Database connection string
# Get this from your Netlify Database dashboard
DATABASE_URL=postgresql://user:password@host:port/database

# Admin PIN for protected deletion (change this!)
HOUSE_POINTS_ADMIN_PIN=your-secure-pin

# CORS origin for frontend (set to your GitHub Pages or Netlify domain)
CORS_ORIGIN=https://your-domain.com

# Node environment
NODE_ENV=production
